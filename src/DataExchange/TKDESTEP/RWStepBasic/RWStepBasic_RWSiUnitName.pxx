#ifndef _RWStepBasic_RWSiUnitName_HeaderFile
#define _RWStepBasic_RWSiUnitName_HeaderFile

#include <StepBasic_SiUnitName.hxx>
#include <Standard_CString.hxx>

namespace RWStepBasic_RWSiUnitName
{
static constexpr char sunHertz[]         = ".HERTZ.";
static constexpr char sunDegreeCelsius[] = ".DEGREE_CELSIUS.";
static constexpr char sunSiemens[]       = ".SIEMENS.";
static constexpr char sunSievert[]       = ".SIEVERT.";
static constexpr char sunLux[]           = ".LUX.";
static constexpr char sunWatt[]          = ".WATT.";
static constexpr char sunOhm[]           = ".OHM.";
static constexpr char sunSecond[]        = ".SECOND.";
static constexpr char sunBecquerel[]     = ".BECQUEREL.";
static constexpr char sunPascal[]        = ".PASCAL.";
static constexpr char sunHenry[]         = ".HENRY.";
static constexpr char sunTesla[]         = ".TESLA.";
static constexpr char sunVolt[]          = ".VOLT.";
static constexpr char sunJoule[]         = ".JOULE.";
static constexpr char sunKelvin[]        = ".KELVIN.";
static constexpr char sunAmpere[]        = ".AMPERE.";
static constexpr char sunGram[]          = ".GRAM.";
static constexpr char sunSteradian[]     = ".STERADIAN.";
static constexpr char sunMole[]          = ".MOLE.";
static constexpr char sunLumen[]         = ".LUMEN.";
static constexpr char sunGray[]          = ".GRAY.";
static constexpr char sunCandela[]       = ".CANDELA.";
static constexpr char sunFarad[]         = ".FARAD.";
static constexpr char sunRadian[]        = ".RADIAN.";
static constexpr char sunNewton[]        = ".NEWTON.";
static constexpr char sunMetre[]         = ".METRE.";
static constexpr char sunWeber[]         = ".WEBER.";
static constexpr char sunCoulomb[]       = ".COULOMB.";

//! Convert StepBasic_SiUnitName to string
//! @param theNameEnum The StepBasic_SiUnitName value to convert
//! @return The corresponding string representation
inline const char* ConvertToString(const StepBasic_SiUnitName theNameEnum)
{
  switch (theNameEnum)
  {
    case StepBasic_SiUnitName::StepBasic_sunHertz:
      return sunHertz;
    case StepBasic_SiUnitName::StepBasic_sunDegreeCelsius:
      return sunDegreeCelsius;
    case StepBasic_SiUnitName::StepBasic_sunSiemens:
      return sunSiemens;
    case StepBasic_SiUnitName::StepBasic_sunSievert:
      return sunSievert;
    case StepBasic_SiUnitName::StepBasic_sunLux:
      return sunLux;
    case StepBasic_SiUnitName::StepBasic_sunWatt:
      return sunWatt;
    case StepBasic_SiUnitName::StepBasic_sunOhm:
      return sunOhm;
    case StepBasic_SiUnitName::StepBasic_sunSecond:
      return sunSecond;
    case StepBasic_SiUnitName::StepBasic_sunBecquerel:
      return sunBecquerel;
    case StepBasic_SiUnitName::StepBasic_sunPascal:
      return sunPascal;
    case StepBasic_SiUnitName::StepBasic_sunHenry:
      return sunHenry;
    case StepBasic_SiUnitName::StepBasic_sunTesla:
      return sunTesla;
    case StepBasic_SiUnitName::StepBasic_sunVolt:
      return sunVolt;
    case StepBasic_SiUnitName::StepBasic_sunJoule:
      return sunJoule;
    case StepBasic_SiUnitName::StepBasic_sunKelvin:
      return sunKelvin;
    case StepBasic_SiUnitName::StepBasic_sunAmpere:
      return sunAmpere;
    case StepBasic_SiUnitName::StepBasic_sunGram:
      return sunGram;
    case StepBasic_SiUnitName::StepBasic_sunSteradian:
      return sunSteradian;
    case StepBasic_SiUnitName::StepBasic_sunMole:
      return sunMole;
    case StepBasic_SiUnitName::StepBasic_sunLumen:
      return sunLumen;
    case StepBasic_SiUnitName::StepBasic_sunGray:
      return sunGray;
    case StepBasic_SiUnitName::StepBasic_sunCandela:
      return sunCandela;
    case StepBasic_SiUnitName::StepBasic_sunFarad:
      return sunFarad;
    case StepBasic_SiUnitName::StepBasic_sunRadian:
      return sunRadian;
    case StepBasic_SiUnitName::StepBasic_sunNewton:
      return sunNewton;
    case StepBasic_SiUnitName::StepBasic_sunMetre:
      return sunMetre;
    case StepBasic_SiUnitName::StepBasic_sunWeber:
      return sunWeber;
    case StepBasic_SiUnitName::StepBasic_sunCoulomb:
      return sunCoulomb;
  }
  return nullptr; // Default value
}

//! Convert string to StepBasic_SiUnitName
//! @param theNameStr The string to convert
//! @param theResultEnum The corresponding StepBasic_SiUnitName value
//! @return true if the conversion was successful, false otherwise
inline bool ConvertToEnum(const char* const theNameStr, StepBasic_SiUnitName& theResultEnum)
{
  if (IsEqual(theNameStr, sunHertz))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunHertz;
  }
  else if (IsEqual(theNameStr, sunDegreeCelsius))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunDegreeCelsius;
  }
  else if (IsEqual(theNameStr, sunSiemens))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunSiemens;
  }
  else if (IsEqual(theNameStr, sunSievert))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunSievert;
  }
  else if (IsEqual(theNameStr, sunLux))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunLux;
  }
  else if (IsEqual(theNameStr, sunWatt))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunWatt;
  }
  else if (IsEqual(theNameStr, sunOhm))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunOhm;
  }
  else if (IsEqual(theNameStr, sunSecond))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunSecond;
  }
  else if (IsEqual(theNameStr, sunBecquerel))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunBecquerel;
  }
  else if (IsEqual(theNameStr, sunPascal))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunPascal;
  }
  else if (IsEqual(theNameStr, sunHenry))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunHenry;
  }
  else if (IsEqual(theNameStr, sunTesla))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunTesla;
  }
  else if (IsEqual(theNameStr, sunVolt))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunVolt;
  }
  else if (IsEqual(theNameStr, sunJoule))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunJoule;
  }
  else if (IsEqual(theNameStr, sunKelvin))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunKelvin;
  }
  else if (IsEqual(theNameStr, sunAmpere))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunAmpere;
  }
  else if (IsEqual(theNameStr, sunGram))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunGram;
  }
  else if (IsEqual(theNameStr, sunSteradian))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunSteradian;
  }
  else if (IsEqual(theNameStr, sunMole))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunMole;
  }
  else if (IsEqual(theNameStr, sunLumen))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunLumen;
  }
  else if (IsEqual(theNameStr, sunGray))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunGray;
  }
  else if (IsEqual(theNameStr, sunCandela))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunCandela;
  }
  else if (IsEqual(theNameStr, sunFarad))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunFarad;
  }
  else if (IsEqual(theNameStr, sunRadian))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunRadian;
  }
  else if (IsEqual(theNameStr, sunNewton))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunNewton;
  }
  else if (IsEqual(theNameStr, sunMetre))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunMetre;
  }
  else if (IsEqual(theNameStr, sunWeber))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunWeber;
  }
  else if (IsEqual(theNameStr, sunCoulomb))
  {
    theResultEnum = StepBasic_SiUnitName::StepBasic_sunCoulomb;
  }
  else
  {
    return false;
  }
  return true;
}

} // namespace RWStepBasic_RWSiUnitName
#endif // _RWStepBasic_RWSiUnitName_HeaderFile
